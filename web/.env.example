# Local StackGen site with Payload embedded (same Next.js process).
# Postgres: docker compose -f stack/docker-compose.yml up postgres -d
# Then: pnpm --dir web dev  →  site /  ·  admin /admin
CMS_PROVIDER=payload
DATABASE_URL=postgresql://payload:CHANGE_ME@127.0.0.1:5433/payload
PAYLOAD_SECRET=CHANGE_ME
PAYLOAD_PUBLIC_SERVER_URL=http://127.0.0.1:3000

# Webflow overlay (used when CMS_PROVIDER=webflow)
# WEBFLOW_API_TOKEN=
# WEBFLOW_SITE_ID=
# WEBFLOW_CMS_SITE_ID=
