          "gap": 94.49413299560547,
          "justifyContent": "space_between",
          "layoutIncludeStroke": true,
          "children": [
            {
              "type": "text",
              "id": "QmJIw",
              "name": "Aiden for SRE",
              "fill": "#f1eae0ff",
              "content": "Aiden for SRE",
              "lineHeight": 1.100000023841858,
              "fontFamily": "Haffer XH",
              "fontSize": 48,
              "fontWeight": "normal",
              "letterSpacing": 0.48
            },
            {
              "type": "text",
              "id": "EiYuW",
              "name": "Autonomous Incident Investigation & Remediation",
              "fill": "#f1eae0ff",
              "textGrowth": "fixed-width-height",
              "width": 266,
              "height": 49,
              "content": "Autonomous Incident Investigation & Remediation",
              "lineHeight": 1.3200000524520874,
              "fontFamily": "Haffer XH",
              "fontSize": 20,
              "fontWeight": "normal",
              "letterSpacing": -0.04000000059604645
            },
            {
              "type": "text",
              "id": "PNcsC",
              "name": "Aiden for SRE investigates and resolves production incidents by leveraging infrastructure root cause context from the OCG. It handles infrastructure-correlated incidents autonomously—tracing root cause, generating fixes, and deploying them through validated pipelines. For a team experiencing 2 P1s per month, ADF targets a 40% prevention rate and reduces MTTR from 4 hours to under 15 minutes for infrastructure-correlated cases.",
              "fill": "#f1eae0ff",
              "textGrowth": "fixed-width",
              "width": 611,
              "content": "Aiden for SRE investigates and resolves production incidents by leveraging infrastructure root cause context from\rthe OCG. \n\nIt handles infrastructure-correlated incidents autonomously—tracing root cause, generating fixes, and\rdeploying them through validated pipelines. \n\nFor a team experiencing 2 P1s per month, ADF targets a 40%\rprevention rate and reduces MTTR from 4 hours to under 15 minutes for infrastructure-correlated cases.",
              "lineHeight": 1.3200000524520874,
              "fontFamily": "Haffer XH",
